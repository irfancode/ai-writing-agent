# AI Writing Agent - Environment Configuration

# ===========================================
# LLM API Keys (at least one required)
# ===========================================

# OpenAI API Key (Recommended - Best overall quality)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (Recommended - Best for long-form)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# DeepSeek API Key (Optional - Cost effective)
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ===========================================
# Ollama Configuration (Optional - For local models)
# ===========================================

# Ollama API Base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ===========================================
# Application Settings
# ===========================================

# Default primary model (gpt-4o, claude-3-5-sonnet, deepseek-chat, etc.)
DEFAULT_MODEL=gpt-4o

# Default secondary model
SECONDARY_MODEL=claude-3-5-sonnet

# Output directory for exported content
OUTPUT_DIR=./output

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ===========================================
# Content Generation Defaults
# ===========================================

# Default tone (professional, casual, friendly, formal)
DEFAULT_TONE=friendly

# Default content length (short, medium, long)
DEFAULT_LENGTH=medium

# Maximum tokens per generation
MAX_TOKENS=4096

# Temperature (0.0 to 1.0, lower = more focused)
TEMPERATURE=0.7

# ===========================================
# UI Configuration
# ===========================================

# Gradio UI port
GRADIO_PORT=7860

# Streamlit port
STREAMLIT_PORT=8501

# Enable/disable specific UIs
ENABLE_GRADIO=true
ENABLE_STREAMLIT=false

# ===========================================
# Advanced Settings
# ===========================================

# Enable memory/conversation history
ENABLE_MEMORY=true

# Memory persistence path
MEMORY_PATH=./memory.json

# Maximum conversation history entries
MAX_HISTORY=100
